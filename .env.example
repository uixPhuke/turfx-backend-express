NODE_ENV=development
PORT=8000
POSTGRES_API_PORT=8001
# Existing API persistence. PostgreSQL cutover is a separate migration milestone.
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=playza_development
REDIS_URL=redis://127.0.0.1:6379
# Target PostgreSQL database. Never point migration experiments at production.
DATABASE_URL=postgresql://playza:replace-me@127.0.0.1:5432/playza_development
JWT_SECRET=replace-with-a-long-random-access-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-refresh-secret
OTP_SECRET=replace-with-a-different-long-random-otp-secret
JWT_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d
EMAIL_USER=
EMAIL_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOWED_ORIGINS=http://localhost:8081
CLIENT_URL=http://localhost:8081
API_URL=http://localhost:8000
LOG_LEVEL=info
# Set to the exact number of trusted reverse proxies in production.
TRUST_PROXY_HOPS=0

# Set operator-approved billing rates before accepting production payments.
BOOKING_TAX_BPS=0
BOOKING_FEE_MINOR=0

APP_ENV=local
EXPO_ACCESS_TOKEN=
