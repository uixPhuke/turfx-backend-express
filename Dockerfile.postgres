FROM node:22-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM base AS build
COPY package*.json ./
RUN npm ci
COPY prisma ./prisma
RUN DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build npm run db:generate
COPY tsconfig.json ./
COPY src ./src
RUN npm run build:foundation

# Release migration job contains the pinned Prisma CLI, without downloading tools at startup.
FROM build AS migrate
CMD ["npm", "run", "db:migrate:deploy"]

FROM build AS production-deps
RUN npm prune --omit=dev

FROM base AS runtime
ENV NODE_ENV=production POSTGRES_API_PORT=8001
COPY --from=production-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/.playza-build ./.playza-build
COPY --from=build --chown=node:node /app/prisma ./prisma
COPY --from=build --chown=node:node /app/src/utils/sendEmail.js ./src/utils/sendEmail.js
COPY --chown=node:node package*.json ./
USER node
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+process.env.POSTGRES_API_PORT+'/api/v2/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", ".playza-build/postgres/server.js"]
