{
  "name": "turfx-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:security": "jest --runInBand tests/security",
    "build:foundation": "tsc --noEmit false --rootDir src --outDir .playza-build",
    "test:postgres": "npm run build:foundation && node scripts/run-postgres-tests.cjs",
    "start:postgres": "npm run build:foundation && node .playza-build/postgres/server.js",
    "start:worker": "node .playza-build/postgres/worker.js",
    "release:preflight": "node scripts/release-preflight.cjs",
    "verify": "npm run db:validate && npm run typecheck && npm run lint",
    "docs:api": "node scripts/generate-openapi.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/client": "6.19.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.2",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.8.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.3.1",
    "path": "^0.12.7",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^6.0.2",
    "razorpay": "2.9.8",
    "redis": "^6.1.0",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "^5.0.1",
    "xss": "^1.0.15",
    "xss-clean": "^0.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "24.10.0",
    "eslint": "9.39.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "effect": "3.22.4",
    "deepmerge-ts": "8.0.2",
    "swagger-jsdoc": {
      "glob": "14.0.4"
    },
    "glob@>=9.0.0": "14.0.4",
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
